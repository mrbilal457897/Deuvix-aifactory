# --- Site ---
# Canonical origin for sitemap.xml, robots.txt, metadataBase and OG tags.
# Server-only. Falls back to the Vercel deployment URL when unset.
SITE_URL=

# --- Cal.com (self-hosted) ---
NEXT_PUBLIC_CAL_ORIGIN=
NEXT_PUBLIC_CAL_LINK=
CAL_WEBHOOK_SECRET=
# Server-side only, never NEXT_PUBLIC_. Powers the /book-a-call page.
CAL_API_KEY=
# Only needed when the Cal.com account sits inside an organization.
CAL_ORGANIZATION_SLUG=

# --- Database (PostgreSQL) ---
# Session pooler on 5432 (not 6543), plus the CA certificate so the server is
# actually verified instead of trusting sslmode=no-verify. See certs/README.md.
DATABASE_URL=

# --- Email ---
# Preferred: Resend. Set RESEND_API_KEY and the senders land in the inbox
# instead of spam, because the From domain is one Resend has verified for
# SPF/DKIM/DMARC. Free tier is 3,000 emails/month.
# Verify the domain at resend.com -> Domains, then add its DNS records.
RESEND_API_KEY=
# Must be an address on a Resend-verified domain.
RESEND_FROM="DEUX AI Factory <hello@yourdomain.com>"

# Fallback: SMTP. Works for any mailbox, but a consumer address (@gmail.com,
# @outlook.com) cannot pass SPF/DKIM for a domain you control, so recipients
# will see these in spam. Use SMTP only for local/dev or as a fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DEUXAI <hello@yourdomain.com>"
NOTIFY_EMAIL=
# Internal recipient address(es) for new contact submissions. Comma-separated.
CONTACT_TO_EMAIL=

# --- WhatsApp (click-to-chat only) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Booking page (public, safe to expose) ---
# Optional override for the "Can't find a suitable time?" mailto address.
# Defaults to the business email in config/company.ts when unset.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Cron + admin ---
CRON_SECRET=
ADMIN_USER=
ADMIN_PASSWORD=
# Comma-separated emails granted the admin role (auth.ts). Unset = the business
# email from config/company.ts plus the founder account have admin access.
ADMIN_EMAILS=

# --- Chatbot (Gemini) ---
# Required. Server-only — the key is never sent to the browser.
GEMINI_API_KEY=
# Optional: a key from a DIFFERENT Google project, used only by `npm run ingest`.
# The free-tier embedding quota (embed_content, 1000 requests/day) is counted per
# project, so pointing ingestion at a second project keeps indexing from spending
# the chatbot's daily budget. Chat and query embeddings always use the key above.
GEMINI_API_KEY_INGEST=
# Free-tier defaults. gemini-3.5-flash-lite is on the free tier; the 2.5 line
# is access-limited, so do not switch without checking quota first.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Behaviour overrides — all optional, defaults live in src/lib/chat/config.ts.
CHAT_TEMPERATURE=0.2
CHAT_MAX_INPUT_CHARS=1000
CHAT_USER_RATE_LIMIT=10
CHAT_ABUSE_STRIKES=3
CHAT_SIM_THRESHOLD=0.32
CHAT_LOG_EVENTS=true

# Founders contact used when the bot hands off. Leave blank to fall back to
# the Contact page only — the bot will never invent an address.
FOUNDERS_CONTACT_EMAIL=
FOUNDERS_CONTACT_URL=/contact
FOUNDERS_WHATSAPP=
# Optional JSON endpoint the lead form POSTs to. Without it, leads go to
# FOUNDERS_CONTACT_EMAIL (or CONTACT_TO_EMAIL) via the existing mailer.
CHAT_LEAD_WEBHOOK_URL=

# Origin the ingest script fetches Source A from. Start the app first:
#   npm run dev  (then)  npm run ingest -- --source deux --base-url http://localhost:3000
CHAT_SOURCE_BASE_URL=http://localhost:3000

# --- Admin AI agent (self-hosted model) ---
# OpenAI-compatible endpoint. Default targets a local Ollama; the model server
# runs OUTSIDE the deployment. No third-party AI API — no data leaves your infra.
# Start a local server, e.g.:  ollama run qwen2.5:7b   (then enable tool use)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
# Local servers ignore this; OpenAI-compatible gateways usually need a non-empty value.
LLM_API_KEY=
# All optional; defaults live in src/lib/ai/config.ts.
LLM_TIMEOUT_MS=60000
LLM_MAX_STEPS=8
LLM_TEMPERATURE=0.2
AI_MAX_INPUT_CHARS=4000
AI_HISTORY_WINDOW=12
AI_RATE_LIMIT=30
AI_MAX_TOOL_RESULT_CHARS=12000

# --- Admin AI agent: voice input (optional) ---
# Speech-to-text server (self-hosted faster-whisper behind FastAPI). When unset,
# voice input is disabled entirely and the mic never appears. The server must
# expose POST /transcribe (multipart "file") and GET /health.
STT_BASE_URL=
# Optional model override forwarded to the speech server.
STT_MODEL=
STT_API_KEY=
STT_TIMEOUT_MS=120000
# Max recording upload size in bytes (enforced before buffering).
STT_MAX_UPLOAD_BYTES=8000000
# Client-side recording cap; a longer recording auto-stops (seconds).
STT_MAX_SECONDS=120